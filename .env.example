# Neon Postgres connection string (pooled endpoint recommended).
# Example: postgresql://user:pass@ep-foo-123.us-east-2.aws.neon.tech/lead_signal?sslmode=require
DATABASE_URL=

# Anthropic API key — Claude Haiku 4.5 with web search powers both company
# enrichment and C-level contact discovery.
ANTHROPIC_API_KEY=

# MillionVerifier single-email API key — verifies pattern-generated emails.
MILLIONVERIFIER_API_KEY=

# AnyMailFinder API key — decision-maker fallback when pattern verification
# finds zero valid emails for a company.
ANYMAILFINDER_API_KEY=

# Instantly campaign — verified contacts are pushed here once per run.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# Google Sheets env vars are only needed for the one-shot backfill from the
# previous Sheets-based storage. Remove after the first successful run has
# populated the Neon companies table.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Sheet1
RAW_SHEET_ID=
RAW_WORKSHEET_NAME=Sheet1

# Anthropic API key for Claude Haiku 4.5 enrichment (employee count + industry).
# Uses server-side web search; billed per request + per search.
ANTHROPIC_API_KEY=
