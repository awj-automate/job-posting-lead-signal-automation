# Paste the full service account JSON as a single-line value.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# The ID from the Google Sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
# Output sheet — only companies that passed the filter.
GOOGLE_SHEET_ID=

# Optional — defaults to "Sheet1"
GOOGLE_WORKSHEET_NAME=Sheet1

# Raw sheet — every company seen, with a Passed lookup? column used as the
# enrichment cache across runs.
RAW_SHEET_ID=

# Optional — defaults to "Sheet1"
RAW_WORKSHEET_NAME=Sheet1

# Anthropic API key for Claude Haiku 4.5 enrichment (employee count + industry).
# Uses server-side web search; billed per request + per search.
ANTHROPIC_API_KEY=
